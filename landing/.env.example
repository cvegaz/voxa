# Landing page configuration (Vite exposes only VITE_*-prefixed vars).
# Copy to landing/.env and fill in. All are optional — sensible placeholders
# are used when unset, and link buttons that resolve to an empty value are hidden.

# Backend origin for the contact form. Leave blank in dev (the Vite proxy
# forwards /api → http://localhost:5310). In prod set it to the backend URL,
# e.g. https://api.voxa.tudominio.com
VITE_API_BASE=

# External links shown in the hero / footer / contact section.
VITE_GITHUB_URL=https://github.com/tu-usuario/voxa

# The deployed Voxa app. When set, the hero's PRIMARY call to action becomes
# "Pruébalo tú mismo" and points here; when empty the button is hidden and
# contact takes the primary slot instead.
VITE_APP_URL=

VITE_LINKEDIN_URL=
VITE_CALENDLY_URL=
VITE_CONTACT_EMAIL=

# playPro Stats in production — the case study's evidence. Unlike the links
# above, this one has a real built-in default (https://app.playprosystems.com).
#
# Left COMMENTED OUT on purpose: the code uses `??`, so an explicitly empty
# value is a deliberate "hide this link" rather than "use the default".
# Copying this file with the line active would silently remove the link.
# Uncomment only to point it elsewhere, or set it empty to hide it.
# VITE_PLAYPRO_URL=
