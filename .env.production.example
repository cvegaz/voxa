# Voxa — production environment template.
#
# Copy to `.env.production` ON THE SERVER, next to docker-compose.prod.yml, and
# fill in real values. This file is committed; `.env.production` is NOT (it is
# covered by the `.env.*` rules in .gitignore) and must never be.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Generate the secrets rather than inventing them:
#   openssl rand -base64 24

# ─── Domain ──────────────────────────────────────────────────────────────────
# Apex only, no scheme and no trailing slash. Caddy derives app.<domain> and
# www.<domain> from it and obtains a certificate for each. Set to `localhost`
# for a local smoke test (and comment out the www block in deploy/Caddyfile).
VOXA_DOMAIN=voxa.example.com

# ─── Database ────────────────────────────────────────────────────────────────
# No default on purpose: compose refuses to start without it rather than
# booting Postgres open. Postgres publishes no host port, but this password is
# still the last thing between a compromised container and the data.
POSTGRES_PASSWORD=

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# The key from the dedicated `voxa-demo` OpenAI project — NOT the shared
# "Default project" one, which is also pps's. That project carries a $15/month
# spend limit, an allowlist of whisper-1 + gpt-4o-mini, and 10 RPM on both, so a
# leak here cannot drain the account or reach a pricier model.
OPENAI_API_KEY=

# ─── Reverse-proxy topology ──────────────────────────────────────────────────
# How many proxies YOU operate in front of the backend. Each appends an entry to
# X-Forwarded-For and the client address is read that many positions FROM THE
# RIGHT; anything further left was written by the caller and may be forged.
# This stack is Caddy → landing|frontend nginx → backend, so: 2.
# Wrong in either direction fails silently — too low and every visitor shares
# one rate-limit bucket, too high and it falls back to the peer address.
TRUSTED_PROXY_HOPS=2

# ─── Images ──────────────────────────────────────────────────────────────────
# Built and pushed by .github/workflows/docker-publish.yml. Override to pin a
# specific tag when rolling back; `:latest` is what the auto-deploy pulls.
VOXA_BACKEND_IMAGE=ghcr.io/cvegaz/voxa-backend:latest
VOXA_FRONTEND_IMAGE=ghcr.io/cvegaz/voxa-frontend:latest
VOXA_LANDING_IMAGE=ghcr.io/cvegaz/voxa-landing:latest

# ─── Public demo limits (ADR-0019) ───────────────────────────────────────────
# Every value below is optional: the image ships the same safe defaults. They
# are listed because tuning them monthly, from the funnel report, is the whole
# reason they are configuration and not constants. An invalid value makes the
# app REFUSE TO BOOT — a typo that silently falls back to a default is the exact
# failure these limits exist to prevent.
#
# Owner's hard ceiling is $10/month: $7 operating (below) plus $3 released BY
# HAND once the funnel shows the wall is hitting real visitors. The daily figure
# sits deliberately above monthly/30 (~$0.23) so a good day is not punished; a
# saturated month therefore runs out before day 30, which is the signal that
# real demand arrived.
DEMO_BUDGET_DAILY_USD=0.45
DEMO_BUDGET_MONTHLY_USD=7.00

# Recording bounds, in seconds. Enforced by MEASURING the upload with ffprobe,
# never by trusting the client's reported duration.
MIN_AUDIO_DURATION_SECONDS=1.0
MAX_AUDIO_DURATION_SECONDS=20.0

# Byte ceiling for one upload. Not a duration control (a low-bitrate file hides
# many minutes under any cap) — a cheap pre-filter so an absurd upload is never
# buffered or decoded. Caddy rejects above 8MB at the edge; this is the app's
# own, tighter limit, sized for a 20s stereo WAV (~3.4 MB).
MAX_AUDIO_BYTES=4194304

# Per-IP limits on the endpoints that spend money. The hourly cap blunts a
# burst, the daily one a slow drip that would stay under it.
BILLABLE_RATE_LIMIT_HOUR=10/hour
BILLABLE_RATE_LIMIT_DAY=20/day
ANONYMOUS_MAX_NARRATIONS=3
DEMO_LEAD_RATE_LIMIT=20/hour
CONTACT_RATE_LIMIT=30/minute

# Estimated USD per billable operation. The ledger exists to stop runaway spend,
# not to reconcile an invoice. Update when OpenAI changes prices — config, not a
# release.
DEMO_COST_TRANSCRIPTION=0.0020
DEMO_COST_EXTRACTION=0.0004
DEMO_COST_ENRICHMENT=0.0005

# ─── CORS ────────────────────────────────────────────────────────────────────
# Leave EMPTY in this topology. The landing calls /api/contact same-origin
# through its own nginx (landing/nginx.conf), so no cross-origin request is ever
# made and no allowlist is needed. Fill it only if the landing is ever moved off
# this host (S3+CloudFront, Vercel), which would make it cross-origin again.
LANDING_ORIGINS=

# ─── Contact-form email notification (OPTIONAL) ──────────────────────────────
# Blank = submissions are persisted to the database only, and read with
# `scripts/funnel_report.py`. Set all of these to also receive an email.
CONTACT_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
