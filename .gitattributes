# Normalize line endings: store text with LF in the repo, check out native on each OS.
# This prevents "phantom diffs" where a whole file shows as changed just from CRLF/LF.
* text=auto eol=lf

# Scripts that must stay LF even on Windows checkouts
*.sh   text eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets — never normalize or diff as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  text
*.xlsx binary
*.pdf  binary
*.woff binary
*.woff2 binary

# Lockfiles: keep diffs but don't let them count toward language stats
package-lock.json linguist-generated=true
