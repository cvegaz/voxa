# Development and test dependencies. Everything in requirements.in, plus the
# tooling needed to run the suite.
#
# Kept separate so the production image installs ONLY what it runs: pytest and
# hypothesis have no business inside a container exposed to the internet, both
# for size and for attack surface.
#
# Generated counterpart: requirements-dev.txt
#     .venv/bin/pip-compile requirements-dev.in

-r requirements.in

