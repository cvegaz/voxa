# Plantilla de variables de entorno del backend.
# Copia este archivo a backend/.env y rellena los valores reales.
# NUNCA subas backend/.env a git (está en .gitignore).

# --- Base de datos PostgreSQL ---
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/db_audio_excel

# --- API keys de los modelos de IA ---
# Anthropic (Claude): extracción y enriquecimiento de contexto
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (Whisper): transcripción de audio a texto
OPENAI_API_KEY=sk-...
