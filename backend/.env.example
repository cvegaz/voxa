# Backend environment-variable template.
# Copy this file to backend/.env and fill in the real values.
# NEVER commit backend/.env to git (it is in .gitignore).

# --- PostgreSQL database ---
# Format: postgresql://user:password@host:port/database_name
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/db_audio_excel

# --- AI models API key ---
# OpenAI does EVERYTHING: audio transcription (Whisper) +
# context enrichment and field extraction (gpt-4o-mini).
OPENAI_API_KEY=sk-...
