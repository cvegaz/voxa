# Backend environment-variable template.
# Copy this file to backend/.env and fill in the real values.
# NEVER commit backend/.env to git (it is in .gitignore).

# --- PostgreSQL database ---
# Format: postgresql://user:password@host:port/database_name
# Host port 5330 = voxa's reserved "+30 database" slot (~/Dev/PORTS.md). Inside
# Docker this is overridden to postgres://...@db:5432 (container-internal).
DATABASE_URL=postgresql://postgres:postgres@localhost:5330/db_audio_excel

# --- AI models API key ---
# OpenAI does EVERYTHING: audio transcription (Whisper) +
# context enrichment and field extraction (gpt-4o-mini).
OPENAI_API_KEY=sk-...

# --- Public demo limits (ADR-0019) ---
# All optional: the defaults below are the safe values. They live in the
# environment so a monthly adjustment is an edit + restart, never a rebuild.
# An invalid value makes the app REFUSE TO BOOT on purpose — a typo that silently
# falls back to a default is the exact failure these limits exist to prevent.

# Recording length bounds, in seconds. The 20s cap comes from ADR-0014 and was
# re-examined and kept by ADR-0019 (a shorter cap truncates real narrations:
# dictating one record with a date and a phone number takes 15-20s).
# Enforced by MEASURING the uploaded file with ffprobe, never by trusting the client.
MIN_AUDIO_DURATION_SECONDS=1.0
MAX_AUDIO_DURATION_SECONDS=20.0

# Byte ceiling for one upload. NOT a duration control (a low-bitrate file hides
# many minutes under any cap) — it is a cheap pre-filter so an absurd upload is
# never buffered or decoded. Sized for the worst accepted format: a 20s stereo
# WAV is ~3.4 MB.
MAX_AUDIO_BYTES=4194304

# Per-IP limits on the endpoints that spend money (transcribe / extract /
# confirm — confirming runs the LLM enrichment call, so it is billable too).
# Two windows: the hourly cap blunts a burst, the daily one blunts a slow drip
# that would stay under it. An honest anonymous trial is 1 template + 3
# narrations, so a real visitor never approaches either.
BILLABLE_RATE_LIMIT_HOUR=10/hour
BILLABLE_RATE_LIMIT_DAY=20/day

# How many reverse proxies YOU operate in front of the backend. Each one appends
# an entry to X-Forwarded-For, and the client's real address is read that many
# positions FROM THE RIGHT — anything further left was written by the caller and
# may be forged.
#
#   0  (default) no proxy: use the peer address and IGNORE the header entirely.
#      Fail secure — otherwise anyone could reset their own quota with a header.
#   2  production: Caddy -> frontend nginx -> backend.
#
# Getting this wrong is silent in both directions: too low and you rate-limit
# your own proxy (every visitor shares one bucket); too high and you fall back to
# the peer (same effect, no spoofing). Set it to match the real topology.
TRUSTED_PROXY_HOPS=0

# Global spend ceilings for the demo (ADR-0019 §3). The per-IP limit above stops
# ONE caller; this stops a thousand honest visitors, or one caller behind a VPN.
#
# MONTHLY is the real stop. DAILY exists to bound the blast radius of a single
# bad night: a monthly-only cap can be drained in one scripted afternoon and
# leave the demo dark for three weeks.
#
# The daily figure is deliberately ABOVE monthly/30 (~$0.23) so a good day is not
# punished; a saturated month therefore runs out before day 30. That is intended
# — running out means real demand arrived, and is the cue to widen these numbers.
#
# Owner's hard ceiling is $10/month: $7 operating + $3 headroom released BY HAND
# once the funnel data shows the wall is hitting real visitors.
DEMO_BUDGET_DAILY_USD=0.45
DEMO_BUDGET_MONTHLY_USD=7.00

# Estimated cost per billable operation, in USD. Estimates priced from OpenAI's
# published rates — the ledger exists to stop runaway spend, not to reconcile an
# invoice. Update these when OpenAI changes prices; it is config, not a release.
DEMO_COST_TRANSCRIPTION=0.0020
DEMO_COST_EXTRACTION=0.0004
DEMO_COST_ENRICHMENT=0.0005

# Narrations allowed in one anonymous trial (ADR-0019 §2). Reaching it closes the
# session; the rows already captured stay downloadable and the UI points at the
# download rather than dead-ending. This is the ONLY row cap in the app — when
# accounts land, the paid tiers become a per-plan lookup and this stays the
# anonymous default.
ANONYMOUS_MAX_NARRATIONS=3

# Per-IP cap on the demo lead form (the optional email field). Generous: a human
# submits this once or twice; the cap only blunts an automated flood.
DEMO_LEAD_RATE_LIMIT=20/hour

# --- Landing page (public marketing site) ---
# Comma-separated list of origins allowed to call the API cross-origin (the
# landing page's contact form). Defaults to the local dev servers if unset.
LANDING_ORIGINS=http://localhost:5301

# Per-IP rate limit for POST /api/contact (slowapi syntax). Optional.
CONTACT_RATE_LIMIT=30/minute

# --- Contact form email notifications (OPTIONAL) ---
# If these are set, each contact submission also emails CONTACT_NOTIFY_EMAIL.
# Leave them blank to only persist submissions in the database.
CONTACT_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
